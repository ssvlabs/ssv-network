# Core RPC endpoints
# MAINNET_ETH_NODE_URL is preferred for forking; MAINNET_RPC_URL remains supported.
MAINNET_ETH_NODE_URL=
MAINNET_RPC_URL=
HOODI_RPC_URL=

# Signer private keys
# Must match the on-chain owner for live upgrades.
MAINNET_PRIVATE_KEY=
HOODI_PRIVATE_KEY=

# Optional SSV token address overrides for Hardhat network config.
MAINNET_SSVTOKEN_ADDRESS=
HOODI_SSVTOKEN_ADDRESS=

# Block explorer verification
ETHERSCAN_KEY=

# Optional oracle ID fallback
# Used only when deployments/<env>/config.json omits defaultOracleIds.
DEFAULT_ORACLE_IDS=1,2,3,4

# Forked test runner overrides
# `just test-fork <env>` usually populates these automatically from deploy/upgrade result JSON.
FORK_BLOCK_NUMBER=
FORK_TEST_NETWORK=hardhat_forked
FORK_CONFIG_PATH=
FORK_SSV_NETWORK_ADDRESS=
FORK_SSV_NETWORK_VIEWS=
FORK_SSV_TOKEN=
FORK_CSSV_TOKEN=
FORK_DAO_ADDRESS=
FORK_USE_DEPLOYED_STATE=true
FORK_STRICT_DEPLOYED_STATE=false
FORK_ALLOW_DEPLOYED_FALLBACK=true

# Optional v2.0.0 protocol overrides for tests and forked runs
# These mirror deployments/<env>/config.json when set manually.
FORK_NETWORK_FEE_ETH=3550900000
FORK_NETWORK_FEE_SSV=
FORK_MIN_OPERATOR_ETH_FEE=1065200000
FORK_MAX_OPERATOR_ETH_FEE=5326300000
FORK_OPERATOR_MAX_FEE_INCREASE=1000
FORK_DECLARE_OPERATOR_FEE_PERIOD=604800
FORK_EXECUTE_OPERATOR_FEE_PERIOD=604800
FORK_MIN_LIQ_COLLATERAL=940000000000000
FORK_VALIDATORS_PER_OPERATOR_LIMIT=3000
FORK_DEFAULT_ORACLE_IDS=1,2,3,4
FORK_DEFAULT_UNSTAKE_COOLDOWN=604800

# Optional test and gas-report toggles
RUN_FORK=
NO_GAS_ENFORCE=
REPORT_GAS=
GAS_REPORT_DIR=.
BASELINE_TAG=v1.2.0
CURRENT_LABEL=current
GAS_COMPARE_OUTPUT=gas-compare.txt
COVERAGE=

# v2.0.0 protocol reference values (not read from .env during deploy/upgrade)
# Source of truth: deployments/<env>/config.json
# NETWORK_FEE_ETH=3550900000
# MIN_OPERATOR_ETH_FEE=1065200000
# MAX_OPERATOR_ETH_FEE=5326300000
# DEFAULT_OPERATOR_ETH_FEE=1770000000
# MINIMUM_LIQUIDATION_COLLATERAL_ETH=940000000000000
# LIQUIDATION_THRESHOLD_PERIOD=35800
# MIN_BLOCKS_BETWEEN_UPDATES=7200
# OPERATOR_MAX_FEE_INCREASE=1000
# DECLARE_OPERATOR_FEE_PERIOD=604800
# EXECUTE_OPERATOR_FEE_PERIOD=604800
# QUORUM_BPS=7500
