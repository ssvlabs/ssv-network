{
  "name": "ssv-network",
  "version": "2.0.0",
  "description": "Solidity smart contracts for the SSV Network",
  "author": "SSV.Network",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssvlabs/ssv-network.git"
  },
  "license": "MIT",
  "keywords": [
    "ssv",
    "ssv.network",
    "solidity",
    "staking"
  ],
  "files": [
    "contracts/**/*.sol",
    "!contracts/**/deprecated/**",
    "!contracts/**/mocks/**",
    "!contracts/**/test/**",
    "!contracts/**/upgrades/**",
    "abis/CSSVToken.json",
    "abis/ISSVStaking.json",
    "abis/SSVClusters.json",
    "abis/SSVDAO.json",
    "abis/SSVNetwork.json",
    "abis/SSVNetworkViews.json",
    "abis/SSVOperators.json",
    "abis/SSVOperatorsWhitelist.json",
    "abis/SSVStaking.json",
    "abis/SSVToken.json",
    "abis/SSVValidators.json",
    "abis/SSVViews.json",
    "docs/",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npx hardhat compile",
    "test": "npx hardhat test",
    "test:gas": "npx hardhat test --gas-stats",
    "test:unit": "bash scripts/ci/run-test-family.sh unit",
    "test:unit:gas": "bash scripts/ci/run-test-family.sh unit --gas-stats",
    "test:integration": "bash scripts/ci/run-test-family.sh integration",
    "test:e2e": "bash scripts/ci/run-test-family.sh e2e",
    "test:sanity": "bash scripts/ci/run-test-family.sh sanity",
    "test:families:check": "bash scripts/ci/test-family-files.sh --check",
    "test:integration:gas": "bash scripts/ci/run-test-family.sh integration --gas-stats",
    "test-forked": "RUN_FORK=true FORK_USE_DEPLOYED_STATE=false bash scripts/ci/run-test-family.sh fork",
    "test-forked:legacy": "RUN_FORK=true FORK_USE_DEPLOYED_STATE=false bash scripts/ci/run-test-family.sh fork-legacy",
    "gas:report": "REPORT_GAS=true npx hardhat test",
    "gas:compare": "npx tsx scripts/gas-compare.ts",
    "gas:limits": "npx tsx scripts/gas-compare.ts --mode limits --expected-ops scripts/ci/gas-expected-ops.txt",
    "gas:exact": "npx tsx scripts/gas-compare.ts --mode exact --expected-ops scripts/ci/gas-expected-ops.txt --baseline",
    "gas:ci": "env -u NO_GAS_ENFORCE REPORT_GAS=true npx hardhat test mocha && npx tsx scripts/gas-compare.ts --mode limits --expected-ops scripts/ci/gas-expected-ops.txt",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint --fix . --ext .ts",
    "solidity-coverage": "NO_GAS_ENFORCE=1 npx hardhat test --coverage",
    "slither": "npx hardhat compile --force && slither . --hardhat-ignore-compile --solc-remaps @openzeppelin=node_modules/@openzeppelin --filter-paths \"contracts/test/\" --exclude-informational --exclude-dependencies",
    "size-contracts": "npx hardhat size-contracts",
    "pack:check": "bash scripts/ci/check-pack.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.12",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-mocha": "4.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@nomicfoundation/hardhat-verify": "3.1.3",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@types/chai": "4.3.20",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.2",
    "chai": "5.3.3",
    "dotenv": "17.4.2",
    "ethers": "6.17.0",
    "hardhat": "3.19.0",
    "mocha": "12.0.3",
    "solhint": "5.2.0",
    "tsx": "4.23.15"
  }
}
